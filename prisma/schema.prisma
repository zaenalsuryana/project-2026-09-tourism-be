// ===== Generator & datasource =====
generator client {
  provider     = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== Enum =====
enum UserRole {
  SUPER_ADMIN
  MANAGER
  STAFF
  TOURIST
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  STAFF_INVITE
  EMAIL_CHANGE
}

// ===== Auth & user =====
model User {
  id               String           @id @default(uuid(7)) @db.Uuid
  email            String           @unique @db.VarChar(254)
  passwordHash     String?          @map("password_hash")
  fullName         String           @map("full_name") @db.VarChar(120)
  phone            String?          @db.VarChar(20)
  avatarUrl        String?          @map("avatar_url")
  birthDate        DateTime?        @map("birth_date") @db.Date
  city             String?          @db.VarChar(80)
  role             UserRole         @default(TOURIST)
  status           UserStatus       @default(ACTIVE)
  emailVerifiedAt  DateTime?        @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount Int              @default(0) @map("failed_login_count")
  lockedUntil      DateTime?        @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  
  identities       UserIdentity[]
  authTokens       AuthToken[]
  refreshTokens    RefreshToken[]

  @@index([role, status])
  @@map("users")
}

model UserIdentity {
  id               String       @id @default(uuid(7)) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  provider         AuthProvider
  providerUserId   String       @map("provider_user_id") @db.VarChar(191)
  providerEmail    String?      @map("provider_email") @db.VarChar(254)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("user_identities")
}

model AuthToken {
  id               String       @id @default(uuid(7)) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  type             TokenType
  tokenHash        String       @unique @map("token_hash") @db.Char(64)
  payload          Json?
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt           DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model RefreshToken {
  id               String       @id @default(uuid(7)) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  familyId         String       @map("family_id") @db.Uuid
  tokenHash        String       @unique @map("token_hash") @db.Char(64)
  userAgent        String?      @map("user_agent")
  ipAddress        String?      @map("ip_address") @db.Inet
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz(6)
  replacedById     String?      @unique @map("replaced_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces         RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}